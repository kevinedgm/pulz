{
  "$schema": "https://tr.designtokens.org/format/",
  "meta": {
    "name": "PULZ Foundations",
    "version": "1.0.0",
    "status": "approved",
    "approvedAt": "2026-09-28",
    "source": ".fruti/foundations/proposal.yaml",
    "spacingBasePx": 4
  },
  "color": {
    "base": {
      "primary": { "$type": "color", "$value": "#6D4AFF" },
      "secondary": { "$type": "color", "$value": "#FF876F" },
      "surface": { "$type": "color", "$value": "#F8F8FA" },
      "ink": { "$type": "color", "$value": "#18171F" },
      "danger": { "$type": "color", "$value": "#C94D5D" },
      "success": { "$type": "color", "$value": "#187A5B" },
      "warning": { "$type": "color", "$value": "#9A6715" }
    },
    "scale": {
      "primary": { "50": "#EAE7FA", "100": "#DCD5FB", "200": "#C0B2FC", "300": "#A590FD", "400": "#896DFE", "500": "{color.base.primary}", "600": "#6042DD", "700": "#543BBC", "800": "#47339A", "900": "#3A2B79" },
      "secondary": { "50": "#F9EDEC", "100": "#F9E1DE", "200": "#FBCBC2", "300": "#FCB4A7", "400": "#FE9E8B", "500": "{color.base.secondary}", "600": "#DC7663", "700": "#BA6557", "800": "#97554B", "900": "#74443F" },
      "danger": { "50": "#F3E7EA", "100": "#EFD6DB", "200": "#E5B4BB", "300": "#DC919C", "400": "#D26F7C", "500": "{color.base.danger}", "600": "#AE4554", "700": "#943D4A", "800": "#793541", "900": "#5F2D38" },
      "success": { "50": "#E2EBEA", "100": "#CBDFDA", "200": "#9EC6BA", "300": "#72AC9B", "400": "#45937B", "500": "{color.base.success}", "600": "#186B52", "700": "#185C49", "800": "#184D40", "900": "#183F37" },
      "warning": { "50": "#EFEAE3", "100": "#E5DBCC", "200": "#D2BE9E", "300": "#C0A171", "400": "#AD8443", "500": "{color.base.warning}", "600": "#865B16", "700": "#734F18", "800": "#60431A", "900": "#4C371B" }
    },
    "semantic": {
      "background": "{color.base.surface}",
      "text": "{color.base.ink}",
      "textMuted": "#5D5A68",
      "border": "#D9D8DE",
      "focus": "{color.base.primary}",
      "action": "{color.base.primary}",
      "actionText": "#FFFFFF",
      "accent": "{color.base.secondary}",
      "accentText": "{color.base.ink}",
      "danger": "{color.base.danger}",
      "dangerText": "{color.scale.danger.700}",
      "success": "{color.base.success}",
      "successText": "{color.scale.success.700}",
      "warning": "{color.base.warning}",
      "warningText": "{color.scale.warning.700}"
    },
    "dark": {
      "$description": "Roles semánticos bajo prefers-color-scheme: dark o data-theme=dark. Los roles base y las escalas no cambian.",
      "background": "#121118",
      "surface": "#1C1B23",
      "text": "#F2F1F5",
      "textMuted": "#AAA7B5",
      "border": "#4F4D5C",
      "focus": "{color.scale.primary.300}",
      "action": "{color.scale.primary.300}",
      "actionText": "{color.base.ink}",
      "accent": "{color.scale.secondary.300}",
      "accentText": "{color.base.ink}",
      "dangerText": "{color.scale.danger.200}",
      "successText": "{color.scale.success.200}",
      "warningText": "{color.scale.warning.200}",
      "status": { "ok": "{color.scale.success.300}", "okBg": "#16302A", "pend": "{color.scale.warning.300}", "pendBg": "#302716", "late": "{color.scale.danger.300}", "lateBg": "#33191D", "info": "{color.scale.primary.300}", "infoBg": "#262046" },
      "tint": { "ink100": "#2A2450", "clay100": "#3D2A26" }
    }
  },
  "typography": {
    "family": {
      "primary": { "$type": "fontFamily", "$value": ["Manrope", "system-ui", "sans-serif"] },
      "secondary": { "$type": "fontFamily", "$value": ["Instrument Serif", "Georgia", "serif"] }
    },
    "size": { "xs": "0.75rem", "sm": "0.875rem", "md": "1rem", "lg": "1.125rem", "xl": "1.375rem", "2xl": "1.75rem", "3xl": "2.25rem", "4xl": "3rem" },
    "weight": { "regular": 400, "medium": 500, "semibold": 600, "bold": 700 },
    "lineHeight": { "tight": 1.15, "heading": 1.25, "body": 1.5 },
    "numeric": { "comparative": "tabular-nums" }
  },
  "spacing": { "0": "0px", "1": "4px", "2": "8px", "3": "12px", "4": "16px", "5": "20px", "6": "24px", "8": "32px", "10": "40px", "12": "48px", "16": "64px", "20": "80px", "24": "96px" },
  "sizing": {
    "controlHeight": { "$type": "dimension", "$value": "48px" },
    "touchMinimum": { "$type": "dimension", "$value": "44px" },
    "icon": { "sm": "16px", "md": "20px", "lg": "24px" }
  },
  "radius": {
    "control": { "$type": "dimension", "$value": "10px" },
    "surface": { "$type": "dimension", "$value": "16px" },
    "sm": "8px",
    "lg": "12px",
    "xl": "14px",
    "pill": "999px"
  },
  "iconography": {
    "library": "Lucide",
    "viewBox": 24,
    "strokeWidth": 2,
    "rule": "Iconografía de trazo consistente, simple y contemporánea. Usar iconos para reforzar navegación, acciones y estados, no como decoración. Las acciones ambiguas combinan icono y texto. Ningún estado depende exclusivamente de icono o color. Mantener tamaños y stroke coherentes en todo el producto."
  },
  "motion": {
    "duration": { "fast": "140ms", "standard": "220ms", "emphasis": "320ms" },
    "easing": { "standard": "cubic-bezier(.2,.8,.2,1)" },
    "reducedMotion": "required"
  },
  "adaptive": {
    "compact": { "min": "0px", "max": "599px", "columns": 4, "navigation": "bottom", "description": "Una columna y jerarquía vertical fuerte. Bottom navigation para destinos principales. Acción primaria situada en zona fácilmente alcanzable. Progressive disclosure para información secundaria. Priorizar qué requiere atención y cuál es la siguiente acción. Evitar trasladar tablas o layouts desktop comprimidos." },
    "medium": { "min": "600px", "max": "1023px", "columns": 8, "navigation": "rail", "description": "Navigation rail compacto. Grid de 8 columnas. Aprovechar el espacio adicional para coexistencia selectiva de información y detalle contextual cuando aporte valor. No limitarse a ampliar el layout móvil." },
    "expanded": { "min": "1024px", "columns": 12, "navigation": "sidebar", "description": "Sidebar persistente y grid de 12 columnas. Permitir master-detail, comparación y coexistencia de contexto operativo cuando mejore la tarea. Mantener un ancho de contenido controlado y evitar estirar componentes móviles para llenar la pantalla." }
  },
  "accessibility": {
    "target": "WCAG 2.2 AA",
    "focusVisible": true,
    "colorOnlyMeaning": false,
    "keyboardComplete": true,
    "touchMinimum": "{sizing.touchMinimum}",
    "textZoom": "200%",
    "reducedMotion": true,
    "forcedColors": true,
    "longContentSafe": true
  }
}
