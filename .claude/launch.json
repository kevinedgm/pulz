{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "hub",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "4321",
        "--directory",
        "."
      ],
      "port": 4321
    },
    {
      "name": "web",
      "runtimeExecutable": "/bin/sh",
      "runtimeArgs": [
        "-c",
        "export PATH=\"$HOME/.nvm/versions/node/v22.23.3/bin:$PATH\"; exec pnpm --filter @pulz/web dev -- --port 5173 --strictPort"
      ],
      "port": 5173
    }
  ]
}
